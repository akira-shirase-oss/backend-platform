# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/starter/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/starter-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/starter-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# STARTER_LISTEN=127.0.0.1:61450
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# STARTER_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/starter.service) less the pool and some headroom.
# STARTER_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# STARTER_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# STARTER_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# STARTER_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# STARTER_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# STARTER_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/starter-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# STARTER_REQUEST_TIMEOUT_MS=5000
# STARTER_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# STARTER_MAX_IN_FLIGHT=64

# --- Database (crates/starter-db) ------------------------------------------------------
# STARTER_DB_MAX_CONNECTIONS=16
# STARTER_DB_ACQUIRE_TIMEOUT_MS=2000
# STARTER_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# STARTER_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# STARTER_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least STARTER_ERROR_MIN_REQUESTS were answered.
# STARTER_ERROR_RATE_PERMILLE=50
# STARTER_ERROR_MIN_REQUESTS=20
# STARTER_LOG=info
# json for journald; text for a terminal.
# STARTER_LOG_FORMAT=json

# --- Accounts (crates/starter-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# STARTER_SMTP_RELAY=
# STARTER_MAIL_FROM=accounts@localhost
# Where links in emails point.
# STARTER_PUBLIC_URL=http://127.0.0.1:61450
# STARTER_COOKIE_SECURE=true
# STARTER_SESSION_TTL_S=604800
# STARTER_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# STARTER_TRUSTED_PROXIES=
# STARTER_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# STARTER_PLAN_MAX_MEMBERS=10
# STARTER_PLAN_MAX_TOKENS=10
# STARTER_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/starter/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role starter_app
#   migration-database-url  starterctl migrate, digests, fingerprint, prune-events (starter_owner)
#   admin-database-url      starterctl bootstrap only
#   owner-password          starterctl bootstrap only
#   app-password            starterctl bootstrap only
# STARTER_DATABASE_URL_FILE=/etc/starter/credentials/database-url
# STARTER_MIGRATION_DATABASE_URL_FILE=/etc/starter/credentials/migration-database-url
# STARTER_ADMIN_DATABASE_URL_FILE=/etc/starter/credentials/admin-database-url
# STARTER_OWNER_PASSWORD_FILE=/etc/starter/credentials/owner-password
# STARTER_APP_PASSWORD_FILE=/etc/starter/credentials/app-password
